APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Local dev (compose.override.yaml): host port of the site
APP_PORT=8000
APP_URL=http://localhost:${APP_PORT}
LOG_CHANNEL=daily

# Production (compose.yaml): the Caddy site address and the image to run
APP_DOMAIN=localhost
APP_IMAGE=ghcr.io/esac-ic/esac.nl:latest

# Local dev: "debug" enables Xdebug
XDEBUG_MODE=off

# Local dev: host port of the Vite dev server
# To view on other devices, set FORWARD_HOST=0.0.0.0 and VITE_HOST to your computer LAN IP (e.g. 192.168.1.10),
# run `./dev up` and browse to http://<that IP>:8000
VITE_PORT=5173
#FORWARD_HOST=0.0.0.0
#VITE_HOST=192.168.1.10

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=esac
DB_USERNAME=esac
DB_PASSWORD=password
# Local dev: host port for connecting a database client
FORWARD_DB_PORT=3306

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=database
QUEUE_DRIVER=sync

# Local dev sends mail to mailpit, view it at http://localhost:8025
MAIL_DRIVER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=noreply@esac.nl
MAIL_FROM_NAME="NoReply ESAC"
# Local dev: host ports for mailpit's SMTP server and web interface
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025

MAIL_MAN_URL=http://mailman:8001/3.1
MAIL_MAN_USERNAME=restadmin
MAIL_MAN_PASSWORD=restpass
MAIL_MAN_DOMAIN=@esac.nl
# Local dev: host port for the mailman API
FORWARD_MAILMAN_PORT=8001

OLD_USER_SAVE_PERIODE=2
APPLICATION_RESPONSE_SAVE_PERIODE=2

# Google's reCAPTCHA test keys, which always pass: https://developers.google.com/recaptcha/docs/faq
GOOGLE_RECAPTCHA_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
GOOGLE_RECAPTCHA_SECRET=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

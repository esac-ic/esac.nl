APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
LOG_CHANNEL=daily

# Used by compose.yaml (production): the Caddy site address and the image to run
APP_DOMAIN=localhost
APP_IMAGE=ghcr.io/esac-ic/esac.nl:latest

# Used by compose.override.yaml (local dev only): host port the app is reachable on,
# and the Xdebug mode (set to e.g. "debug" to enable step debugging)
APP_PORT=8000
SAIL_XDEBUG_MODE=off

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=esac
DB_USERNAME=esac
DB_PASSWORD=password
# Used by compose.override.yaml (local dev only): host port forwarded to the mysql
# container, e.g. to connect with a local database client
FORWARD_DB_PORT=3306

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=database
QUEUE_DRIVER=sync

# Routed to the mailpit container started by compose.override.yaml (local dev only);
# view sent mail at http://localhost:8025.
MAIL_DRIVER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=noreply@esac.nl
MAIL_FROM_NAME="NoReply ESAC"
# Used by compose.override.yaml (local dev only): host ports for mailpit's SMTP port
# and its web dashboard
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025

MAIL_MAN_URL=http://mailman:8001/3.1
MAIL_MAN_USERNAME=restadmin
MAIL_MAN_PASSWORD=restpass
MAIL_MAN_DOMAIN=@esac.nl
# Used by compose.override.yaml (local dev only): host port forwarded to the mailman
# container
FORWARD_MAILMAN_PORT=8001

OLD_USER_SAVE_PERIODE=2
APPLICATION_RESPONSE_SAVE_PERIODE=2

# Google's reCAPTCHA test keys, which always pass: https://developers.google.com/recaptcha/docs/faq
GOOGLE_RECAPTCHA_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
GOOGLE_RECAPTCHA_SECRET=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe


# Eboekhouden
EBOEKHOUDEN_URL=https://api.e-boekhouden.nl
EBOEKHOUDEN_API_TOKEN=
EBOEKHOUDEN_SOURCE="Local Esac Website"